{
  "name": "@alwaysmeticulous/common",
  "version": "3.12.0",
  "description": "Meticulous common utilities",
  "license": "ISC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "@alwaysmeticulous/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./candidate-prs": {
      "@alwaysmeticulous/source": "./src/candidate-prs/index.ts",
      "types": "./dist/candidate-prs/index.d.ts",
      "default": "./dist/candidate-prs/index.js"
    },
    "./constants": {
      "@alwaysmeticulous/source": "./src/constants.ts",
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./git-commit-sha": {
      "@alwaysmeticulous/source": "./src/git-commit-sha.utils.ts",
      "types": "./dist/git-commit-sha.utils.d.ts",
      "default": "./dist/git-commit-sha.utils.js"
    },
    "./json": {
      "@alwaysmeticulous/source": "./src/json.utils.ts",
      "types": "./dist/json.utils.d.ts",
      "default": "./dist/json.utils.js"
    },
    "./virtual-time-order": {
      "@alwaysmeticulous/source": "./src/virtual-time-order.utils.ts",
      "types": "./dist/virtual-time-order.utils.d.ts",
      "default": "./dist/virtual-time-order.utils.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "candidate-prs": [
        "./dist/candidate-prs/index.d.ts"
      ],
      "constants": [
        "./dist/constants.d.ts"
      ],
      "git-commit-sha": [
        "./dist/git-commit-sha.utils.d.ts"
      ],
      "json": [
        "./dist/json.utils.d.ts"
      ],
      "virtual-time-order": [
        "./dist/virtual-time-order.utils.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc --build tsconfig.json",
    "dev": "tsc --build tsconfig.json --watch",
    "format": "prettier --write src",
    "lint": "oxlint --type-aware src",
    "lint:commit": "eslint --cache $(git diff --relative --name-only --diff-filter=ACMRTUXB master | grep  -E \"(.js$|.ts$|.tsx$)\")",
    "lint:fix": "oxlint --type-aware src --fix",
    "depcheck": "depcheck --ignore-patterns=dist",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "loglevel": "^1.8.0",
    "luxon": "^3.2.1",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@alwaysmeticulous/api": "workspace:*",
    "@alwaysmeticulous/sdk-bundles-api": "workspace:*",
    "@types/luxon": "^3.2.0",
    "vitest": "catalog:"
  },
  "author": {
    "name": "The Meticulous Team",
    "email": "eng@meticulous.ai",
    "url": "https://meticulous.ai"
  },
  "engines": {
    "node": ">= 18"
  },
  "homepage": "https://github.com/alwaysmeticulous/meticulous-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/alwaysmeticulous/meticulous-sdk.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/alwaysmeticulous/meticulous-sdk/issues"
  }
}
