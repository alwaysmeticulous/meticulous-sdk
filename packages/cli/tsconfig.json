{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    /* Projects */
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    /* Modules */
    "rootDir": "./src",
    "resolveJsonModule": true,
    /* Emit */
    "outDir": "./dist"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    // Vendored doc/agent content is copied verbatim into dist by the postbuild
    // script; it's written against webapp-frontend's tsconfig, not this
    // package's, and isn't meant to be type-checked here.
    "src/commands/onboard/templates/vendored"
  ]
}
